      {q:"Describe a situation where you disagreed with your team or manager. How did you handle it?", hint:"Respectful disagreement, evidence, compromise, outcome", kw:["disagree","communicate","evidence","compromise","respect","outcome","listen"]},
      {q:"Tell me about a time you had to learn a new technology quickly. How did you approach it?", hint:"Learning strategy, resources, timeline, application", kw:["learn","documentation","practice","apply","timeline","resource","hands-on"]},
      {q:"Describe a time you made a mistake in production. What happened and what did you do?", hint:"Ownership, immediate fix, root cause analysis, prevention", kw:["mistake","fix","root cause","ownership","post-mortem","prevent","communicate"]},
    ],
    hard: [
      {q:"Tell me about a time you had to make a difficult technical decision with incomplete information.", hint:"Decision framework, risk assessment, stakeholder communication, outcome", kw:["decision","risk","incomplete","stakeholder","framework","outcome","trade-off"]},
      {q:"Describe a situation where you had to lead a project or team without formal authority.", hint:"Influence, alignment, communication, results", kw:["influence","align","communicate","lead","consensus","result","motivation"]},
      {q:"Tell me about a time you significantly improved a system's performance or process.", hint:"Metrics before/after, approach, impact, collaboration", kw:["metrics","before","after","optimize","impact","approach","collaborate"]},
    ]
  },
  conceptual: {
    easy: [
      {q:"What is Big O notation and why does it matter in programming?", hint:"Time complexity, space complexity, O(n), O(log n), examples", kw:["time complexity","space","o(n)","o(log n)","performance","algorithm","efficiency"]},
      {q:"Explain the difference between frontend and backend development.", hint:"Client-side, server-side, responsibilities, technologies", kw:["client","server","browser","database","api","html","css","javascript"]},
    ],
    medium: [
      {q:"What is CI/CD and how does it improve software development?", hint:"Continuous integration, deployment, automation, testing", kw:["continuous","integration","deployment","pipeline","automate","test","build","jenkins"]},
      {q:"Explain the concept of technical debt. How do you manage it?", hint:"Short-term shortcuts, long-term cost, refactoring, prioritization", kw:["shortcut","refactor","maintainability","cost","priority","documentation","legacy"]},
    ],
    hard: [
      {q:"How would you approach building a highly available system with 99.99% uptime?", hint:"Redundancy, failover, monitoring, SLA, disaster recovery", kw:["redundancy","failover","monitoring","sla","disaster recovery","replica","health check"]},
      {q:"Explain event-driven architecture and when you would choose it over request-response.", hint:"Events, pub/sub, decoupling, eventual consistency, Kafka", kw:["event","pub sub","kafka","decouple","eventual consistency","async","message queue"]},
    ]
  },
  scenario: {
    medium: [
      {q:"Your deployed application suddenly starts returning 500 errors for 20% of requests. Walk me through how you would diagnose and fix this.", hint:"Logs, monitoring, recent deployments, rollback, hotfix", kw:["logs","monitor","deploy","rollback","debug","alert","trace","recent change"]},
      {q:"You need to migrate a live database with 50 million records to a new schema with zero downtime. How would you do it?", hint:"Blue-green, dual write, backfill, feature flags, rollback plan", kw:["blue green","dual write","backfill","feature flag","rollback","zero downtime","migration"]},
    ],
    hard: [
      {q:"Your company's API is being hammered by a DDoS attack. What steps do you take in the next 30 minutes?", hint:"Rate limiting, IP blocking, CDN, alerting, communication", kw:["rate limit","ip block","cdn","firewall","alert","communicate","ddos","throttle"]},
      {q:"A critical bug is found in production 30 minutes before a major product launch. What do you do?", hint:"Assess severity, fix vs delay, communication, rollback", kw:["severity","hotfix","rollback","communicate","delay","stakeholder","decision","risk"]},
    ]
  }
};

// ─── KEYWORD SCORING ENGINE ──────────────────────────────────────
function scoreAnswer(answer, question, timeUsed, timeLimit) {
  if (!answer || answer.trim().length < 5) {
    return { score:0, accuracy:0, clarity:0, depth:0, relevance:0, time_eff:0, verdict:"No meaningful answer provided." };
  }
  const ans = answer.toLowerCase();
  const words = ans.split(/\s+/).filter(w => w.length > 2);
  const wordCount = words.length;

  // Keyword matching
  const kw = question.kw || [];
  const matched = kw.filter(k => ans.includes(k.toLowerCase()));
  const kwScore = kw.length > 0 ? matched.length / kw.length : 0.5;

  // Accuracy: based on keyword matches
  const accuracy = Math.round(Math.min(10, 3 + kwScore * 8));

  // Clarity: based on sentence structure and length
  const sentences = answer.split(/[.!?]+/).filter(s => s.trim().length > 5);
  const avgSentLen = wordCount / Math.max(sentences.length, 1);
  const clarityRaw = sentences.length >= 2 && avgSentLen >= 5 && avgSentLen <= 25 ? 7 : 5;
  const clarity = Math.round(Math.min(10, clarityRaw + (wordCount > 30 ? 1 : 0) + (wordCount > 60 ? 1 : 0)));

  // Depth: based on answer length and keyword density
  const depthRaw = wordCount < 15 ? 2 : wordCount < 40 ? 5 : wordCount < 80 ? 7 : 8;
  const depth = Math.round(Math.min(10, depthRaw + kwScore * 2));

  // Relevance: keyword + basic topic overlap
  const relevance = Math.round(Math.min(10, 3 + kwScore * 7));

  // Time efficiency
  const timeRatio = timeUsed / timeLimit;
  const time_eff = timeUsed === 0 ? 0 :
    timeRatio > 1.0 ? 3 :
    timeRatio > 0.9 ? 6 :
    timeRatio > 0.3 ? 9 : 7;

  // Weighted final score
  const score = Math.round(
    accuracy * 0.25 +
    clarity  * 0.20 +
    depth    * 0.25 +
    relevance* 0.20 +
    time_eff * 0.10
  );

  // Verdict
  const verdicts = {
    high: ["Strong answer covering key concepts well.", "Excellent depth and clarity in your response.", "Good coverage of the topic with relevant points."],
    mid:  ["Decent answer but could use more depth.", "Good start — try to include more specific examples.", "Covers basics but misses some important aspects."],
    low:  ["Answer lacks depth — try to elaborate more.", "Key concepts were missing from your response.", "Consider structuring your answer more clearly."]
  };
  const vGroup = score >= 7 ? "high" : score >= 5 ? "mid" : "low";
  const verdict = verdicts[vGroup][Math.floor(Math.random() * 3)];

  // Next difficulty
  const next_difficulty = score >= 8 ? "hard" : score >= 5 ? "medium" : "easy";

  return { score, accuracy, clarity, depth, relevance, time_eff, verdict, next_difficulty };
}

// ─── QUESTION SELECTOR ───────────────────────────────────────────
function pickQuestion(type, difficulty, usedQs) {
  const types = type === "technical" ? ["technical","conceptual","scenario"] :
                type === "behavioral" ? ["behavioral"] :
                ["technical","behavioral","conceptual","scenario"];

  // Shuffle and pick
  const shuffled = types.sort(() => Math.random() - 0.5);
  for (const t of shuffled) {
    const pool = (QB[t] || {})[difficulty] || (QB[t] || {})["medium"] || [];
    const unused = pool.filter(q => !usedQs.includes(q.q));
    if (unused.length > 0) {
      const q = unused[Math.floor(Math.random() * unused.length)];
      const typeLabel = t.charAt(0).toUpperCase() + t.slice(1);
      return { type: typeLabel, text: q.q, hint: q.hint, kw: q.kw };
    }
  }
  // Fallback: allow repeats
  const allQ = Object.values(QB).flatMap(d => Object.values(d).flat());
  const q = allQ[Math.floor(Math.random() * allQ.length)];
  return { type: "Technical", text: q.q, hint: q.hint, kw: q.kw };
}

// ─── APP STATE ───────────────────────────────────────────────────
let S = {
  resume:"", jd:"", type:"mixed", totalQs:8, timePerQ:120,
  currentQ:0, difficulty:"medium", consecutiveWeak:0,
  questions:[], scores:[], answers:[], usedQs:[],
  terminated:false, timerInterval:null, timeLeft:0
};

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-'+id).classList.add('active');
  window.scrollTo(0,0);
}

function startInterview() {
  const resume = document.getElementById('resume-input').value.trim();
  const jd     = document.getElementById('jd-input').value.trim();
  const err    = document.getElementById('setup-err');
  if (!resume) { err.style.display='block'; err.textContent='Please paste your resume.'; return; }
  if (!jd)     { err.style.display='block'; err.textContent='Please paste the job description.'; return; }
  err.style.display = 'none';
  S = {
    resume, jd,
    type: document.getElementById('cfg-type').value,
    totalQs: parseInt(document.getElementById('cfg-qs').value),
    timePerQ: parseInt(document.getElementById('cfg-time').value),
    currentQ:0, difficulty:"medium", consecutiveWeak:0,
    questions:[], scores:[], answers:[], usedQs:[],
    terminated:false, timerInterval:null, timeLeft:0
  };
  const btn = document.getElementById('start-btn');
  btn.disabled=true; btn.textContent='Starting...';
  showScreen('interview');
  updateInterviewHeader();
  setTimeout(loadNextQuestion, 400);
}

function loadNextQuestion() {
  clearInterval(S.timerInterval);
  document.getElementById('answer-input').value='';
  document.getElementById('eval-panel').textContent='Your answer will be evaluated on accuracy, clarity, depth, relevance, and time efficiency.';
  document.getElementById('eval-panel').className='eval-panel';
  document.getElementById('timer-text').textContent='—';
  document.getElementById('q-hint').style.display='none';

  const q = pickQuestion(S.type, S.difficulty, S.usedQs);
  S.questions.push(q);
  S.usedQs.push(q.text);

  document.getElementById('q-type-label').textContent = q.type + ' question';
  document.getElementById('q-body').textContent = q.text;
  document.getElementById('q-hint').textContent = '💡 ' + q.hint;
  document.getElementById('q-hint').style.display = 'block';
  document.getElementById('submit-btn').disabled = false;
  document.getElementById('answer-input').disabled = false;
  document.getElementById('answer-input').focus();
  startTimer();
}

function startTimer() {
  S.timeLeft = S.timePerQ;
  updateTimerDisplay();
  const circ = 138.2;
  S.timerInterval = setInterval(() => {
    S.timeLeft--;
    updateTimerDisplay();
    const arc = document.getElementById('timer-arc');
    const offset = circ - (S.timeLeft / S.timePerQ) * circ;
    arc.style.strokeDashoffset = offset;
    const pct = S.timeLeft / S.timePerQ;
    arc.style.stroke = pct > 0.4 ? '#4f46e5' : pct > 0.2 ? '#d97706' : '#dc2626';
    if (S.timeLeft <= 0) { clearInterval(S.timerInterval); autoSubmit(); }
  }, 1000);
}

function updateTimerDisplay() {
  const t = S.timeLeft;
  const el = document.getElementById('timer-text');
  el.textContent = t >= 60 ? Math.floor(t/60)+':'+(t%60).toString().padStart(2,'0') : t+'s';
  el.className = 'timer-text'+(t<=15?' danger':t<=30?' warn':'');
}

function autoSubmit() {
  const ans = document.getElementById('answer-input').value.trim();
  if (!ans) {
    S.answers.push('(no answer — timed out)');
    S.scores.push(0);
    document.getElementById('eval-panel').textContent='⏰ Time expired with no answer. Score: 0/10';
    S.consecutiveWeak++;
    addHistoryItem(S.currentQ);
    updateThresholdBar();
    if (checkTermination()) return;
    setTimeout(nextQuestion, 2500);
  } else {
    submitAnswer();
  }
}

function submitAnswer() {
  clearInterval(S.timerInterval);
  const ans = document.getElementById('answer-input').value.trim();
  const timeUsed = S.timePerQ - S.timeLeft;
  const q = S.questions[S.currentQ];
  document.getElementById('answer-input').disabled = true;
  document.getElementById('submit-btn').disabled = true;
  S.answers.push(ans || '(skipped)');

  const ev = scoreAnswer(ans, q, timeUsed, S.timePerQ);
  S.scores.push(ev.score);
  S.difficulty = ev.next_difficulty || S.difficulty;
  if (ev.score <= 3) S.consecutiveWeak++; else S.consecutiveWeak = 0;

  const bc = ev.score>=7?'badge-good':ev.score>=5?'badge-avg':'badge-bad';
  document.getElementById('eval-panel').innerHTML =
    `<div class="badges">
      <span class="badge ${bc}">${ev.score}/10 overall</span>
      <span class="badge badge-avg">Accuracy ${ev.accuracy}/10</span>
      <span class="badge badge-avg">Clarity ${ev.clarity}/10</span>
      <span class="badge badge-avg">Depth ${ev.depth}/10</span>
      <span class="badge badge-avg">Time ${ev.time_eff}/10</span>
    </div>
    <div style="font-size:12px;color:var(--text);margin-top:6px">${ev.verdict}</div>`;

  const avg = S.scores.reduce((a,b)=>a+b,0)/S.scores.length;
  document.getElementById('live-score').textContent = Math.round(avg*10);
  addHistoryItem(S.currentQ);
  updateThresholdBar();
  if (checkTermination()) return;
  setTimeout(nextQuestion, 3000);
}

function skipQuestion() {
  clearInterval(S.timerInterval);
  S.answers.push('(skipped)');
  S.scores.push(1);
  S.consecutiveWeak++;
  document.getElementById('eval-panel').textContent='Skipped. Score: 1/10';
  addHistoryItem(S.currentQ);
  updateThresholdBar();
  if (!checkTermination()) setTimeout(nextQuestion, 1500);
}

function checkTermination() {
  const avg = S.scores.length>0 ? S.scores.reduce((a,b)=>a+b,0)/S.scores.length : 10;
  if (S.consecutiveWeak>=3 || (S.scores.length>=3 && avg<2.5)) {
    S.terminated=true;
    setTimeout(()=>showScreen('terminated'),1500);
    return true;
  }
  return false;
}

function nextQuestion() {
  S.currentQ++;
  if (S.currentQ >= S.totalQs) { showResults(); return; }
  updateInterviewHeader();
  loadNextQuestion();
}

function updateInterviewHeader() {
  const n = S.currentQ+1;
  document.getElementById('q-counter').textContent=`Q ${n} / ${S.totalQs}`;
  const d = S.difficulty;
  const dp = document.getElementById('diff-pill');
  dp.textContent = d.charAt(0).toUpperCase()+d.slice(1);
  dp.className = 'pill pill-'+d;
  document.getElementById('progress-fill').style.width=((n-1)/S.totalQs*100)+'%';
}

function updateThresholdBar() {
  if (!S.scores.length) return;
  const avg = S.scores.reduce((a,b)=>a+b,0)/S.scores.length;
  const pct = Math.round(avg/10*100);
  const fill = document.getElementById('th-fill');
  fill.style.width=pct+'%';
  fill.style.background=pct>=60?'#059669':pct>=35?'#d97706':'#dc2626';
  document.getElementById('th-label').textContent=`${pct}% (minimum: 30%)`;
}

function addHistoryItem(i) {
  const q=S.questions[i], s=S.scores[i];
  const el=document.createElement('div');
  el.className='history-item';
  const col=s>=7?'#059669':s>=5?'#d97706':'#dc2626';
  el.innerHTML=`<span class="history-q">Q${i+1}: ${q?.text||'Question'}</span><span style="font-weight:600;color:${col}">${s}/10</span>`;
  const list=document.getElementById('history-list');
  list.appendChild(el);
  if (list.children.length>5) list.firstChild.remove();
}

function showResults() {
  showScreen('results');
  const total = S.scores.length>0 ? Math.round(S.scores.reduce((a,b)=>a+b,0)/S.scores.length*10) : 0;
  document.getElementById('final-score-num').textContent=total;
  const circ=376.99;
  const rc=document.getElementById('ring-circle');
  setTimeout(()=>{ rc.style.strokeDashoffset=circ-(total/100)*circ; },100);
  rc.style.stroke=total>=70?'#059669':total>=50?'#d97706':'#dc2626';

  const badge=document.getElementById('readiness-badge');
  if (total>=70){badge.textContent='Strong candidate';badge.className='readiness-badge rb-strong';}
  else if(total>=50){badge.textContent='Average candidate';badge.className='readiness-badge rb-avg';}
  else{badge.textContent='Needs improvement';badge.className='readiness-badge rb-weak';}

  document.getElementById('readiness-sub').textContent=
    S.terminated?'Interview terminated early due to below-threshold performance.':
    `Completed ${S.scores.length} of ${S.totalQs} questions`;

  // Skill breakdown based on question types answered
  const typeScores = {};
  S.questions.forEach((q,i)=>{
    if(!typeScores[q.type]) typeScores[q.type]={sum:0,count:0};
    typeScores[q.type].sum+=S.scores[i]||0;
    typeScores[q.type].count++;
  });
  const colors=['#4f46e5','#059669','#d97706','#7c3aed','#0891b2','#dc2626'];
  const skillKeys = Object.keys(typeScores);
  document.getElementById('skill-breakdown').innerHTML = skillKeys.map((k,i)=>{
    const avg=Math.round(typeScores[k].sum/typeScores[k].count);
    return `<div class="skill-row">
      <span class="skill-name">${k}</span>
      <div class="skill-bar-bg"><div class="skill-bar-fill" style="width:${avg*10}%;background:${colors[i%colors.length]}"></div></div>
      <span class="skill-val">${avg}/10</span>
    </div>`;
  }).join('');

  // Strengths and weaknesses based on scores
  const goodQs = S.questions.filter((_,i)=>S.scores[i]>=7);
  const badQs  = S.questions.filter((_,i)=>S.scores[i]<=4);
  const strengths = goodQs.length>0 ?
    goodQs.slice(0,3).map(q=>`Strong performance on ${q.type.toLowerCase()} questions`) :
    ["Completed the interview","Attempted all questions","Showed up and practiced"];
  const weaknesses = badQs.length>0 ?
    badQs.slice(0,4).map(q=>`Needs improvement: ${q.type} — ${q.text.substring(0,50)}...`) :
    ["Continue practicing harder questions","Work on answer depth","Practice under time pressure"];

  document.getElementById('strengths-list').innerHTML=strengths.map(s=>`<li><span class="icon">✅</span>${s}</li>`).join('');
  document.getElementById('weaknesses-list').innerHTML=weaknesses.map(w=>`<li><span class="icon">⚠️</span>${w}</li>`).join('');

  // Feedback
  const feedbacks = [];
  const avgScore = S.scores.length>0?S.scores.reduce((a,b)=>a+b,0)/S.scores.length:0;
  if(avgScore<5) feedbacks.push("Focus on learning core concepts before attempting medium/hard questions.");
  if(avgScore>=5&&avgScore<7) feedbacks.push("You have a good base — work on adding more depth and examples to your answers.");
  if(avgScore>=7) feedbacks.push("Great performance! Challenge yourself with system design and complex scenarios.");
  const skipped=S.answers.filter(a=>a.includes('skipped')||a.includes('timed out')).length;
  if(skipped>0) feedbacks.push(`You skipped or timed out on ${skipped} question(s) — practice answering under time pressure.`);
  feedbacks.push("Use the STAR method (Situation, Task, Action, Result) for behavioral questions.");
  feedbacks.push("Always include real examples and metrics in technical answers to demonstrate experience.");
  document.getElementById('feedback-items').innerHTML=feedbacks.map(f=>`<div class="feedback-item">${f}</div>`).join('');

  // Hiring verdict
  const icons={70:'✅',50:'⚠️',0:'❌'};
  const icon = total>=70?'✅':total>=50?'⚠️':'❌';
  const title = total>=70?'Recommended for hire':total>=50?'Borderline candidate':'Not yet ready';
  const detail = total>=70?
    'Candidate demonstrated strong technical and communication skills aligned with the role requirements.':
    total>=50?
    'Candidate shows potential but needs more preparation, especially in depth of technical answers.':
    'Candidate needs significant improvement before being ready for this role. Continue practicing.';
  document.getElementById('hiring-icon').textContent=icon;
  document.getElementById('hiring-title').textContent=title;
  document.getElementById('hiring-detail').textContent=detail;

  // Q&A review
  document.getElementById('sessions-list').innerHTML=S.questions.map((q,i)=>{
    const s=S.scores[i]??0;
    const col=s>=7?'#059669':s>=5?'#d97706':'#dc2626';
    return `<div class="session-item">
      <div class="session-q">[${q.type}] Q${i+1}: ${q.text}</div>
      <div class="session-ans">${S.answers[i]||'(no answer)'}</div>
      <div class="session-score" style="color:${col}">Score: ${s}/10</div>
    </div>`;
  }).join('');
}

function resetApp() {
  clearInterval(S.timerInterval);
  document.getElementById('history-list').innerHTML='';
  const btn=document.getElementById('start-btn');
  btn.disabled=false; btn.textContent='▶ Start Interview';
  showScreen('setup');
}
</script>
